# Supply-chain hardening: never run dependency install scripts
# (preinstall/install/postinstall), the vector used by Shai-Hulud-style worms.
# No dependency here needs one (fsevents is optional and ships prebuilt).
# Note: this also skips our own prepublishOnly; publish.yml runs build+test explicitly.
ignore-scripts=true
# Only resolve versions published at least 3 days ago (npm 11.x recent releases; older npm warns "Unknown project config" and ignores it).
min-release-age=3
